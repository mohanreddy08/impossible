# Copy to .env. Never commit real values.
APP_ENV=development
# SQLite for local dev; PostgreSQL for deployment, e.g. postgresql+psycopg2://user:CHANGE-ME@host:5432/health_companion
DATABASE_URL=sqlite:///./health_companion.db
DATASET_DIR=../health-worker-datasets

# disabled = local development ONLY (no authentication). api_key = required for any shared/deployed server.
AUTH_MODE=disabled
# role|worker_id|key;role|worker_id|key   (roles: worker, admin, hospital). Generate long random keys, e.g. `openssl rand -hex 32`.
API_KEYS=
# Salt for hashing device installation ids. Set a long random value in deployment.
DEVICE_HASH_SALT=change-me

# Retrieval evidence threshold and eligibility (only VERIFIED + approved passages are searchable)
EVIDENCE_MIN_SCORE=0.5
EVIDENCE_MIN_MATCHED_TERMS=2
ELIGIBLE_VERIFICATION_STATUSES=VERIFIED

# Synthetic data is anchored at 2026-10-13. Leave blank to use the real current date.
REFERENCE_DATE=2026-10-13

# ---------------------------------------------------------------- supervisor website
# Signs website sessions (JWT). Production refuses to start without >= 32 random characters: `openssl rand -hex 32`.
SECRET_KEY=change-me
# Website session length in minutes (renewed while in use)
SESSION_MINUTES=30
# Only if the website is served from ANOTHER origin than the API (normally leave empty: CORS stays closed)
SITE_ORIGIN=
# Fixed public https address shown to phones (else the address scripts/start_public.sh writes to ../run/public_url.txt)
PUBLIC_URL=
# The hackathon pack (synthetic block data + protocols)
H5_DATA=../h5-pack-data
# "Today" for the block's visit list (the pack is made for 2026-10-26). Blank = real today.
DEMO_TODAY=2026-10-26
# Days to keep the Q&A audit and admin audit (also editable in Settings)
RETENTION_DAYS=180

# Hide /docs and /openapi.json in production
DOCS_ENABLED=true
# Testing only (not read by the app): TEST_DB=postgres runs the suite on real PostgreSQL via pgserver (see README)
