# For docker compose (this folder). Copy to .env and replace every change-me. Never commit .env.
#   openssl rand -hex 32     (or: python3 -c "import secrets; print(secrets.token_hex(32))")
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me
DEVICE_HASH_SALT=change-me
# First admin password (else a random one is printed once in the app log and saved to run/demo_credentials.txt)
ADMIN_PASSWORD=
# Password of the demo supervisor/ASHA accounts (else random)
DEMO_PASSWORD=
# production hides /docs; set development + DOCS_ENABLED=true to browse the API locally
APP_ENV=production
DOCS_ENABLED=false
DEMO_TODAY=2026-10-26
# Fixed public https address, if you have one (Render URL or named tunnel)
PUBLIC_URL=
